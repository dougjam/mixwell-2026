---
import Base from '../layouts/Base.astro';
import AuthorBlock from '../components/AuthorBlock.astro';
import Badges from '../components/Badges.astro';
import PrimaryLinks from '../components/PrimaryLinks.astro';
import BibtexBlock from '../components/BibtexBlock.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import CardGrid from '../components/CardGrid.astro';
import Card from '../components/Card.astro';
import { withBase, isExternal } from '../lib/paths';
import { siteConfig } from '../lib/data';

const c = siteConfig;

// Machine-readable paper metadata for search engines and Google Scholar.
// Every value comes verbatim from site.config.yaml; nothing is invented here.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const scholarMeta = [
  { name: 'citation_title', content: c.title },
  ...c.authors.map((a) => ({ name: 'citation_author', content: a.name })),
  { name: 'citation_publication_date', content: '2026/07' },
  { name: 'citation_journal_title', content: c.venue.full },
  { name: 'citation_volume', content: c.venue.volume },
  { name: 'citation_issue', content: c.venue.number },
  { name: 'citation_doi', content: c.doi },
  ...(c.links.paperPdf ? [{ name: 'citation_pdf_url', content: c.links.paperPdf }] : []),
  { name: 'citation_abstract_html_url', content: pageUrl },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: c.title,
  author: c.authors.map((a) => ({
    '@type': 'Person',
    name: a.name,
    ...(a.homepage ? { url: a.homepage } : {}),
  })),
  datePublished: '2026-07',
  isPartOf: {
    '@type': 'PublicationIssue',
    issueNumber: c.venue.number,
    isPartOf: {
      '@type': 'PublicationVolume',
      volumeNumber: c.venue.volume,
      isPartOf: { '@type': 'Periodical', name: c.venue.full },
    },
  },
  identifier: `https://doi.org/${c.doi}`,
  sameAs: c.paperUrl,
  url: pageUrl,
  abstract: c.abstract,
};

// Landing card grid: the site's main sections.
const sections = [
  {
    href: '/demos/webgpu',
    title: 'WebGPU Demo',
    blurb: 'Progressive, resolution-independent mixing in your browser (WebGPU).',
    thumbnail: 'thumbs/webgpu-demo.webp',
  },
  {
    href: '/demos/shaders',
    title: 'Shader Gallery',
    blurb: 'Shadertoy examples of Mixwell brushes and Reverse-Drift Functions.',
    thumbnail: 'thumbs/shader-brushbird.webp',
  },
  {
    href: '/code',
    title: 'Code & Libraries',
    blurb: 'GLSL, HLSL, OSL, and OpenCL implementations you can drop into your pipeline.',
    thumbnail: 'thumbs/code-mixwell.svg',
  },
  // Explainers hidden for now (no content yet). Re-add when an article exists;
  // the /explainers page and seed article remain in place.
];

---

<Base>
  <Fragment slot="head">
    {scholarMeta.map((m) => <meta name={m.name} content={m.content} />)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div class="container">
    <!-- Title + authors -->
    <header class="paper-head">
      <p class="eyebrow">{c.venue.full} · {c.venue.published}</p>
      <h1>{c.title}</h1>
      <AuthorBlock authors={c.authors} />
      <Badges badges={c.badges} />
      {
        c.stamp && (
          <a class="stamp" href={c.stamp.url} target="_blank" rel="noopener noreferrer">
            <img src={c.stamp.image} alt="" width="48" height="48" loading="lazy" />
            <span>{c.stamp.label}</span>
          </a>
        )
      }
    </header>

    <!-- Teaser hero -->
    <section class="hero section" aria-label="Teaser">
      {
        c.teaser.teaserVideoId ? (
          <YouTubeEmbed id={c.teaser.teaserVideoId} title="Mixwell teaser" />
        ) : (
          <a
            class="hero__link"
            href={withBase('/scarves')}
            aria-label="Explore the full 16K teaser render"
          >
            <img
              class="hero__img"
              src={withBase(c.teaser.image)}
              alt={c.teaser.alt}
              width="1920"
              height="850"
            />
            <span class="hero__zoom">⤢ Explore the full 16K render</span>
          </a>
        )
      }
    </section>

    <!-- Abstract -->
    <section class="section abstract" aria-labelledby="abstract-h">
      <h2 id="abstract-h">Abstract</h2>
      <p class="abstract__text">{c.abstract}</p>
    </section>

    <!-- Primary links -->
    <section aria-label="Primary links">
      <PrimaryLinks config={c} />
      <div id="bibtex" class="bibtex-anchor">
        <BibtexBlock bibtex={c.bibtex} />
      </div>
    </section>

    <!-- Section cards -->
    <section class="section" aria-labelledby="explore-h">
      <h2 id="explore-h">Explore Demos and Code</h2>
      <CardGrid>
        {
          sections.map((s) => (
            <Card href={s.href} title={s.title} blurb={s.blurb} thumbnail={s.thumbnail} />
          ))
        }
      </CardGrid>
    </section>

    {/* Gallery preview hidden for now (no images yet). The /gallery page and
        gallery.yaml data remain in place; re-add this section and the nav link
        in Base.astro to bring it back. */}

    <!-- News / changelog -->
    {
      c.news.length > 0 && (
        <section class="section" aria-labelledby="news-h">
          <h2 id="news-h">News</h2>
          <ul class="news">
            {c.news.map((n) => (
              <li class="news__item">
                <time class="news__date" datetime={n.date}>
                  {n.date}
                </time>
                <span class="news__text">
                  {n.url ? (
                    <a
                      href={isExternal(n.url) ? n.url : withBase(n.url)}
                      target={isExternal(n.url) ? '_blank' : undefined}
                      rel={isExternal(n.url) ? 'noopener noreferrer' : undefined}
                    >
                      {n.text}
                    </a>
                  ) : (
                    n.text
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .hero {
    margin-top: var(--space-8);
  }
  .hero__link {
    position: relative;
    display: block;
    cursor: zoom-in;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .hero__img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    aspect-ratio: 1920 / 850;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .hero__link:hover .hero__img {
    transform: scale(1.02);
  }
  .hero__zoom {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: color-mix(in srgb, #000 60%, transparent);
    color: #fff;
    font-size: var(--step--1);
    font-weight: 550;
    border-radius: 999px;
    backdrop-filter: blur(4px);
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .hero__link:hover .hero__zoom {
    opacity: 1;
  }
  .paper-head {
    margin-top: var(--space-8);
  }
  .paper-head h1 {
    text-wrap: balance;
  }

  /* Replicability stamp badge (GRSI) */
  .stamp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-1);
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 550;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .stamp:hover {
    text-decoration: none;
    border-color: var(--accent);
    color: var(--text);
  }
  .stamp img {
    width: 48px;
    height: 48px;
    flex: none;
  }

  /* Abstract: a single justified column spanning the full content width. */
  .abstract__text {
    margin: 0;
    text-align: justify;
    hyphens: auto;
  }
  .bibtex-anchor {
    scroll-margin-top: 5rem;
    margin-top: var(--space-4);
  }
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .section-head h2 {
    margin: 0;
  }
  .news {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .news__item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .news__date {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    font-size: var(--step--1);
    min-width: 6rem;
  }
  .news__text {
    flex: 1;
  }
</style>
